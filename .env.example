# Conexão com o DW (mesmo Postgres do airflow_api_sienge)
DATABASE_URL=postgresql+psycopg://dw_admin:SENHA@localhost:5432/dw_sienge

# Schema de onde o painel lê:
#   suprimentos_mock -> dados mockup (python -m scripts.seed_mock)
#   suprimentos      -> dados reais carregados pela DAG etl_pedidos_compra
DW_SCHEMA=suprimentos_mock

# Minutos que o índice de similaridade/dimensões ficam em cache na memória
CACHE_MINUTOS=30

DASH_DEBUG=true
DASH_PORT=8050

# Sessão/login: chave que assina o cookie (OBRIGATÓRIA fora do modo debug). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PAINEL_SECRET_KEY=
# PAINEL_SESSAO_HORAS=10
# PAINEL_COOKIE_SEGURO=true   # só atrás de HTTPS
